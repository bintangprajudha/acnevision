# AcneVision - .env untuk backend tim (FastAPI/Supabase) yang memanggil server model
# Dibuat tim model 2026-11-19. Contoh kode pemakaian: docs/INSTRUKSI_FRONTEND_BACKEND.md bagian 3.5 di repo model.
#
# PENTING
# - URL di bawah adalah Cloudflare quick tunnel SEMENTARA; berubah setiap kali server model dinyalakan ulang.
#   Minta URL terbaru ke tim model, atau siapkan named tunnel / domain tetap (API.md bagian 2).
# - Server model TIDAK memvalidasi token Supabase. Validasi JWT wajib dilakukan di backend ini sebelum meneruskan gambar.
# - Rate limit server model per IP: capture 10/menit, preview 120/menit. Semua request dari backend terlihat dari
#   satu IP; bila kurang, minta tim model menaikkan ACNEVISION_RATE_CAPTURE atau pakai /predict dengan API key.

# Base URL server model (tanpa garis miring di akhir). Endpoint: {ACNE_MODEL_URL}/detect, {ACNE_MODEL_URL}/health
ACNE_MODEL_URL=https://careful-ruby-tests-gourmet.trycloudflare.com/api/v1

# Batas waktu request ke server model (detik). Capture ±0,6-1 s di server + unggah; jangan < 30.
ACNE_MODEL_TIMEOUT_S=60

# Opsional: API key untuk endpoint internal /predict (header X-API-Key). Tidak dipakai untuk /detect.
# Minta ke tim model lewat jalur privat; JANGAN di-commit dan JANGAN dikirim ke aplikasi HP.
# (Tim model perlu menyetel ACNEVISION_API_KEY yang tetap; tanpa itu key berganti setiap server dinyalakan.)
ACNE_MODEL_API_KEY=

# Diisi tim backend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
