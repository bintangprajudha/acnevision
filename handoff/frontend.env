# AcneVision - .env untuk repo acnevision-mobile (salin menjadi `.env` di root repo frontend)
# Dibuat tim model 2026-11-19. Panduan: docs/INSTRUKSI_FRONTEND_BACKEND.md dan docs/API.md di repo model.
#
# PENTING
# - URL di bawah adalah Cloudflare quick tunnel SEMENTARA. URL berubah setiap kali server model dinyalakan ulang;
#   minta URL terbaru ke tim model sebelum menguji, lalu restart Vite / build ulang APK.
# - Harus https:// untuk APK (WebView Capacitor memakai https://localhost; http:// diblokir sebagai mixed content).
# - Uji di PC yang sama dengan server model boleh memakai: VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# - Server model hanya menyediakan POST /detect (+ /health). /analyze, /scans, /chat, /me, /admin -> 404,
#   kecuali VITE_API_BASE_URL diarahkan ke backend tim yang meneruskan /detect ke server model.

# false = pakai server asli (true = mock di browser, tanpa model)
VITE_USE_MOCK=false

# Server model langsung (jalur tamu). Bila backend tim sudah meneruskan /detect, ganti dengan URL backend + /api/v1.
VITE_API_BASE_URL=https://careful-ruby-tests-gourmet.trycloudflare.com/api/v1

# Diisi tim backend (Supabase project). Kosong = tanpa login (semua request sebagai tamu).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
